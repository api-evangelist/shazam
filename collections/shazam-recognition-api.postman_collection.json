            },
            "url": {
              "protocol": "https",
              "path": [
                "discovery",
                "v5",
                ":language",
                ":endpoint_country",
                ":device",
                "-",
                "tag",
                ":uuid_1",
                ":uuid_2"
              ],
              "host": [
                "amp",
                "shazam",
                "com"
              ],
