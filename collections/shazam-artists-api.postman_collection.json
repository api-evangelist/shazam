  "info": {
    "_postman_id": "5071317c-af23-445c-8634-20e0a353d39e",
    "name": "Shazam REST Albums Artists API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Shazam REST API (reverse-engineered, also available via RapidAPI) provides song recognition from audio signatures, music charts by country/city/genre, artist profiles, track metadata, search, and listening-counter statistics. Base URL variants: amp.shazam.com (recognition), www.shazam.com (catalog/charts), cdn.shazam.com (related tracks).\n\n\nContact Support:\n Name: Shazam Developer (via Apple / ShazamKit)",
      "type": "text/plain"
    }
  }
