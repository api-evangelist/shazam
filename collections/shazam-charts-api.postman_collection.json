          "name": "Get tracks from a chart playlist",
          "request": {
            "name": "Get tracks from a chart playlist",
            "description": {
              "content": "Retrieve the tracks in a Shazam chart playlist. Used for top world tracks, top country tracks, top city tracks, and genre charts. The playlist_id is obtained from the chart locations service.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "services",
                "amapi",
                "v1",
                "catalog",
                ":endpoint_country",
                "playlists",
                ":playlist_id",
                "tracks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "200",
                  "description": "Maximum number of tracks to return"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Pagination offset"
                },
                {
                  "disabled": false,
                  "key": "l",
                  "value": "en-US",
                  "description": "Language code"
                },
                {
                  "disabled": false,
                  "key": "relate[songs]",
                  "value": "artists,music-videos"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "GB",
                  "key": "endpoint_country",
                  "description": "(Required) ISO 3166-1 alpha-2 country code for localized results"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "playlist_id",
                  "description": "(Required) Shazam playlist identifier for the chart"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
